{
  "manifest_version": 3,
  "name": "Focus Islands Nudge",
  "version": "0.1.0",
  "description": "A gentle Focus Islands reminder on chosen sites while a focus session is active.",
  "key": "",
  "minimum_chrome_version": "102",
  "permissions": [
    "alarms",
    "declarativeNetRequest",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.reddit.com/*",
    "*://*.linkedin.com/*",
    "*://*.minecraft.wiki/*",
    "*://*.minecraft.fandom.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Focus Islands sites",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "nudge.html",
        "nudge.js",
        "style.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
